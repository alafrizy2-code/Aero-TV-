<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/projectivyHostRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipChildren="false"
    android:clipToPadding="false">

    <!-- Scrim ringan di atas & bawah agar wallpaper pribadi tetap luas dan jelas -->
    <View
        android:id="@+id/viewProjectivyTopScrim"
        android:layout_width="match_parent"
        android:layout_height="96dp"
        android:layout_gravity="top"
        android:background="@drawable/bg_projectivy_top_scrim" />

    <View
        android:id="@+id/viewProjectivyBottomScrim"
        android:layout_width="match_parent"
        android:layout_height="310dp"
        android:layout_gravity="bottom"
        android:background="@drawable/bg_projectivy_bottom_scrim" />

    <!-- Scrim ringan untuk halaman TV Apps agar wallpaper tetap terlihat di belakang grid -->
    <View
        android:id="@+id/viewProjectivyDrawerScrim"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#52050914"
        android:visibility="gone" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:orientation="vertical">

        <!-- ============================================== -->
        <!-- 1. TOP BAR: TV Apps (kiri, Drawer) & Status/Jam (kanan) -->
        <!-- ============================================== -->
        <RelativeLayout
            android:id="@+id/layoutProjectivyTopBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:paddingStart="44dp"
            android:paddingTop="18dp"
            android:paddingEnd="44dp"
            android:paddingBottom="8dp">

            <!-- Kiri Atas (Mode TV Apps Drawer sesuai Referensi 2) -->
            <LinearLayout
                android:id="@+id/layoutProjectivyDrawerTitleArea"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentStart="true"
                android:layout_centerVertical="true"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:visibility="gone">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_marginEnd="9dp"
                    android:contentDescription="TV Apps"
                    android:src="@drawable/ic_tv_screen" />

                <TextView
                    android:id="@+id/tvProjectivyDrawerHeaderTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-medium"
                    android:shadowColor="#CC000000"
                    android:shadowDx="1"
                    android:shadowDy="1"
                    android:shadowRadius="4"
                    android:text="TV Apps"
                    android:textColor="#FFFFFF"
                    android:textSize="18sp" />

                <TextView
                    android:id="@+id/tvProjectivyDrawerAppsCount"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:fontFamily="sans-serif"
                    android:shadowColor="#CC000000"
                    android:shadowDx="1"
                    android:shadowDy="1"
                    android:shadowRadius="3"
                    android:textColor="#CBD5E1"
                    android:textSize="11sp"
                    tools:text="• 24 aplikasi" />
            </LinearLayout>

            <!-- Kanan Atas (Status Sistem minimalis: Wi-Fi, Cuaca, Search/Settings, Jam Sistem) -->
            <LinearLayout
                android:id="@+id/layoutProjectivyTopStatusGroup"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:clipChildren="false"
                android:clipToPadding="false"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageButton
                    android:id="@+id/btnProjectivyWifi"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:layout_marginEnd="6dp"
                    android:clickable="true"
                    android:contentDescription="Wi-Fi"
                    android:focusable="true"
                    android:padding="7dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_wifi" />

                <!-- Indikator Cuaca Minimalis (Menggunakan sistem cuaca Aero TV nyata) -->
                <LinearLayout
                    android:id="@+id/btnProjectivyWeather"
                    android:layout_width="wrap_content"
                    android:layout_height="30dp"
                    android:layout_marginEnd="6dp"
                    android:clickable="true"
                    android:contentDescription="Informasi Cuaca"
                    android:focusable="true"
                    android:gravity="center"
                    android:minWidth="32dp"
                    android:orientation="horizontal"
                    android:paddingStart="8dp"
                    android:paddingEnd="8dp">

                    <TextView
                        android:id="@+id/tvProjectivyWeatherBadge"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:fontFamily="sans-serif-bold"
                        android:maxLines="1"
                        android:maxWidth="140dp"
                        android:shadowColor="#CC000000"
                        android:shadowDx="1"
                        android:shadowDy="1"
                        android:shadowRadius="3"
                        android:text="--°"
                        android:textColor="#FFFFFF"
                        android:textSize="11sp"
                        tools:text="29°C" />
                </LinearLayout>

                <ImageButton
                    android:id="@+id/btnProjectivySearch"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:layout_marginEnd="6dp"
                    android:clickable="true"
                    android:contentDescription="Cari Aplikasi"
                    android:focusable="true"
                    android:padding="7dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_search" />

                <ImageButton
                    android:id="@+id/btnProjectivySettings"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:layout_marginEnd="12dp"
                    android:clickable="true"
                    android:contentDescription="Pengaturan Launcher"
                    android:focusable="true"
                    android:padding="7dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_settings" />

                <TextView
                    android:id="@+id/tvProjectivyClock"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-light"
                    android:shadowColor="#DD000000"
                    android:shadowDx="1"
                    android:shadowDy="2"
                    android:shadowRadius="5"
                    android:text="00:00"
                    android:textColor="#FFFFFF"
                    android:textSize="21sp"
                    tools:text="3:45" />
            </LinearLayout>
        </RelativeLayout>

        <!-- ============================================== -->
        <!-- 2. HALAMAN PROJECTIVY HOME SCREEN (Referensi 1) -->
        <!-- ============================================== -->
        <LinearLayout
            android:id="@+id/layoutProjectivyHomeBody"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:orientation="vertical">

            <!-- Ruang Wallpaper Terbuka Luas di Bagian Atas (~40% layar) -->
            <Space
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1" />

            <!-- Bagian Bawah: Apps, Kategori/Sumber Konten, dan Watch Next -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:clipChildren="false"
                android:clipToPadding="false"
                android:orientation="vertical"
                android:paddingBottom="16dp">

                <!-- Header Apps -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="44dp"
                    android:layout_marginEnd="44dp"
                    android:layout_marginBottom="6dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        android:layout_width="17dp"
                        android:layout_height="17dp"
                        android:layout_marginEnd="8dp"
                        android:contentDescription="Ikon Apps"
                        android:src="@drawable/ic_tv_screen" />

                    <TextView
                        android:id="@+id/tvProjectivyAppsHeader"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif-medium"
                        android:shadowColor="#EE000000"
                        android:shadowDx="1"
                        android:shadowDy="1"
                        android:shadowRadius="4"
                        android:text="Apps"
                        android:textColor="#FFFFFF"
                        android:textSize="14sp" />

                    <TextView
                        android:id="@+id/tvProjectivyHomeFocusedApp"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="14dp"
                        android:ellipsize="end"
                        android:fontFamily="sans-serif-bold"
                        android:maxLines="1"
                        android:shadowColor="#EE000000"
                        android:shadowDx="1"
                        android:shadowDy="1"
                        android:shadowRadius="4"
                        android:textColor="#E2E8F0"
                        android:textSize="12sp"
                        tools:text="• TV Apps" />
                </LinearLayout>

                <!-- Deretan Horizontal Kartu Aplikasi -->
                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rvProjectivyHomeApps"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:clipChildren="false"
                    android:clipToPadding="false"
                    android:overScrollMode="never"
                    android:paddingStart="44dp"
                    android:paddingTop="4dp"
                    android:paddingEnd="44dp"
                    android:paddingBottom="6dp" />

                <!-- Bagian Kategori / Sumber Konten Nyata (Posisi tepat seperti MovieBoxTV di Referensi 1) -->
                <LinearLayout
                    android:id="@+id/layoutProjectivyContentSourceSection"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="44dp"
                    android:layout_marginTop="6dp"
                    android:layout_marginEnd="44dp"
                    android:clipChildren="false"
                    android:clipToPadding="false"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/tvProjectivyContentSourceTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="12dp"
                        android:fontFamily="sans-serif-medium"
                        android:shadowColor="#EE000000"
                        android:shadowDx="1"
                        android:shadowDy="1"
                        android:shadowRadius="4"
                        android:text="Sumber Konten"
                        android:textColor="#F8FAFC"
                        android:textSize="14sp" />

                    <HorizontalScrollView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:clipChildren="false"
                        android:clipToPadding="false"
                        android:scrollbars="none">

                        <LinearLayout
                            android:id="@+id/layoutProjectivySourceChips"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:clipChildren="false"
                            android:clipToPadding="false"
                            android:gravity="center_vertical"
                            android:orientation="horizontal" />
                    </HorizontalScrollView>
                </LinearLayout>

                <!-- Header Watch Next -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="44dp"
                    android:layout_marginTop="8dp"
                    android:layout_marginEnd="44dp"
                    android:layout_marginBottom="6dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        android:layout_width="17dp"
                        android:layout_height="17dp"
                        android:layout_marginEnd="8dp"
                        android:contentDescription="Ikon Watch Next"
                        android:src="@drawable/ic_watch_next_tv" />

                    <TextView
                        android:id="@+id/tvProjectivyWatchNextHeader"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif-medium"
                        android:shadowColor="#EE000000"
                        android:shadowDx="1"
                        android:shadowDy="1"
                        android:shadowRadius="4"
                        android:text="Watch Next"
                        android:textColor="#FFFFFF"
                        android:textSize="14sp" />

                    <TextView
                        android:id="@+id/tvProjectivyWatchNextStatus"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:fontFamily="sans-serif"
                        android:shadowColor="#CC000000"
                        android:shadowDx="1"
                        android:shadowDy="1"
                        android:shadowRadius="3"
                        android:textColor="#CBD5E1"
                        android:textSize="11sp"
                        tools:text="Data sistem" />
                </LinearLayout>

                <!-- Deretan Horizontal Watch Next Nyata (jika tersedia dari sistem/sumber terhubung) -->
                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rvProjectivyWatchNext"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:clipChildren="false"
                    android:clipToPadding="false"
                    android:overScrollMode="never"
                    android:paddingStart="44dp"
                    android:paddingTop="4dp"
                    android:paddingEnd="44dp"
                    android:paddingBottom="4dp"
                    android:visibility="gone" />

                <!-- Area Watch Next Kosong (Ditampilkan jujur bila belum ada sumber Watch Next terhubung) -->
                <LinearLayout
                    android:id="@+id/layoutProjectivyWatchNextEmpty"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:clipChildren="false"
                    android:clipToPadding="false"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="44dp"
                    android:paddingTop="4dp"
                    android:paddingEnd="44dp"
                    android:paddingBottom="4dp">

                    <LinearLayout
                        android:id="@+id/cardProjectivyWatchNextEmpty"
                        android:layout_width="290dp"
                        android:layout_height="96dp"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center_vertical"
                        android:orientation="vertical"
                        android:paddingStart="16dp"
                        android:paddingEnd="16dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="sans-serif-bold"
                            android:text="Belum ada konten Watch Next"
                            android:textColor="#F1F5F9"
                            android:textSize="12sp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:fontFamily="sans-serif"
                            android:maxLines="2"
                            android:text="Area ini akan terisi otomatis saat sistem Android TV atau sumber konten terhubung."
                            android:textColor="#94A3B8"
                            android:textSize="10sp" />
                    </LinearLayout>

                    <!-- Slot kosong ringan sebagai penanda area extensible tanpa data palsu -->
                    <View
                        android:id="@+id/viewProjectivyEmptySlot1"
                        android:layout_width="172dp"
                        android:layout_height="96dp"
                        android:layout_marginStart="12dp"
                        android:focusable="false" />

                    <View
                        android:id="@+id/viewProjectivyEmptySlot2"
                        android:layout_width="172dp"
                        android:layout_height="96dp"
                        android:layout_marginStart="12dp"
                        android:focusable="false" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>

        <!-- ============================================== -->
        <!-- 3. HALAMAN PROJECTIVY APP DRAWER / TV APPS (Ref 2) -->
        <!-- ============================================== -->
        <LinearLayout
            android:id="@+id/layoutProjectivyTvAppsBody"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:orientation="vertical"
            android:paddingStart="44dp"
            android:paddingTop="4dp"
            android:paddingEnd="44dp"
            android:paddingBottom="14dp"
            android:visibility="gone">

            <!-- Bar Pencarian Opsional -->
            <LinearLayout
                android:id="@+id/layoutProjectivySearchBar"
                android:layout_width="match_parent"
                android:layout_height="38dp"
                android:layout_marginBottom="10dp"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="12dp"
                android:paddingEnd="8dp"
                android:visibility="gone">

                <ImageView
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:contentDescription="Cari"
                    android:src="@drawable/ic_search" />

                <EditText
                    android:id="@+id/etProjectivySearch"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginStart="8dp"
                    android:layout_weight="1"
                    android:background="@android:color/transparent"
                    android:hint="Cari aplikasi terpasang..."
                    android:imeOptions="actionSearch"
                    android:inputType="text"
                    android:maxLines="1"
                    android:singleLine="true"
                    android:textColor="#FFFFFF"
                    android:textColorHint="#94A3B8"
                    android:textSize="12sp" />

                <ImageButton
                    android:id="@+id/btnProjectivyClearSearch"
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:background="@android:color/transparent"
                    android:contentDescription="Hapus"
                    android:focusable="true"
                    android:padding="4dp"
                    android:rotation="45"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_add"
                    android:visibility="gone" />

                <ImageButton
                    android:id="@+id/btnProjectivyVoiceSearch"
                    android:layout_width="30dp"
                    android:layout_height="30dp"
                    android:background="@android:color/transparent"
                    android:contentDescription="Pencarian Suara"
                    android:focusable="true"
                    android:padding="5dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_mic" />

                <ImageButton
                    android:id="@+id/btnProjectivyCloseSearch"
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:layout_marginStart="4dp"
                    android:background="@android:color/transparent"
                    android:contentDescription="Tutup Pencarian"
                    android:focusable="true"
                    android:padding="4dp"
                    android:rotation="45"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_add" />
            </LinearLayout>

            <TextView
                android:id="@+id/tvProjectivyTvAppsEmpty"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:padding="28dp"
                android:text="Tidak ada aplikasi yang cocok."
                android:textColor="#E2E8F0"
                android:textSize="13sp"
                android:visibility="gone" />

            <!-- Grid ~6 Kolom Kartu Landscape dengan Ikon di Tengah & Wallpaper Terlihat di Belakang -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvProjectivyTvAppsGrid"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:clipChildren="false"
                android:clipToPadding="false"
                android:overScrollMode="never"
                android:paddingTop="8dp"
                android:paddingBottom="10dp" />

            <!-- Nama Aplikasi Terpilih di Tengah Bawah (Sesuai Referensi 2 "My Islam TV") -->
            <TextView
                android:id="@+id/tvProjectivyDrawerFocusedName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="4dp"
                android:ellipsize="end"
                android:fontFamily="sans-serif-medium"
                android:maxLines="1"
                android:shadowColor="#EE000000"
                android:shadowDx="1"
                android:shadowDy="2"
                android:shadowRadius="6"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                tools:text="My Islam TV" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
