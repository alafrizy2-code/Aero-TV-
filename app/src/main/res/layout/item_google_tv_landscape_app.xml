<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/cardGoogleTvLandscapeRoot"
    android:layout_width="164dp"
    android:layout_height="wrap_content"
    android:clickable="true"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:focusable="true"
    android:gravity="center_horizontal"
    android:orientation="vertical">

    <!-- Banner Persegi Panjang Landscape ala Google TV Apps (Referensi 2) -->
    <FrameLayout
        android:id="@+id/frameGoogleTvLandscapeCard"
        android:layout_width="164dp"
        android:layout_height="92dp"
        android:clipChildren="true"
        android:clipToPadding="false">

        <ImageView
            android:id="@+id/ivGoogleTvLandscapeBanner"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:contentDescription="Kartu Aplikasi Landscape"
            android:scaleType="centerCrop"
            tools:src="@drawable/ic_apps_grid" />

        <View
            android:id="@+id/viewGoogleTvLandscapeFocusBorder"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone" />
    </FrameLayout>

    <TextView
        android:id="@+id/tvGoogleTvLandscapeLabel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="5dp"
        android:ellipsize="end"
        android:fontFamily="sans-serif-medium"
        android:gravity="center"
        android:maxLines="1"
        android:shadowColor="#EE000000"
        android:shadowDx="1"
        android:shadowDy="1"
        android:shadowRadius="4"
        android:textColor="#CBD5E1"
        android:textSize="11sp"
        tools:text="Netflix" />

</LinearLayout>
