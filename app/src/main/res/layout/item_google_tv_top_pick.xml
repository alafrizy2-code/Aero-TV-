<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/cardGoogleTvTopPick"
    android:layout_width="156dp"
    android:layout_height="88dp"
    android:layout_marginEnd="12dp"
    android:background="@drawable/bg_football_frosted_glass"
    android:clickable="true"
    android:clipChildren="true"
    android:focusable="true">

    <!-- Latar gambar/banner kartu (dari app.banner / artwork nyata) -->
    <ImageView
        android:id="@+id/ivTopPickBackdrop"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:contentDescription="Kartu Rekomendasi"
        android:scaleType="centerCrop" />

    <!-- Scrim gelap bawah agar teks terbaca jelas -->
    <View
        android:id="@+id/viewTopPickScrim"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#66090F1E" />

    <!-- Isi Kartu -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="bottom|start"
        android:orientation="vertical"
        android:padding="10dp">

        <TextView
            android:id="@+id/tvTopPickBadge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="#880F172A"
            android:fontFamily="sans-serif-bold"
            android:paddingStart="6dp"
            android:paddingTop="2dp"
            android:paddingEnd="6dp"
            android:paddingBottom="2dp"
            android:text="LIVE"
            android:textColor="#38BDF8"
            android:textSize="9sp" />

        <TextView
            android:id="@+id/tvTopPickTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:ellipsize="end"
            android:fontFamily="sans-serif-bold"
            android:maxLines="2"
            android:shadowColor="#EE000000"
            android:shadowDx="1"
            android:shadowDy="1"
            android:shadowRadius="4"
            android:textColor="#FFFFFF"
            android:textSize="12sp"
            tools:text="Semua Aplikasi" />

        <TextView
            android:id="@+id/tvTopPickSubtitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="1dp"
            android:ellipsize="end"
            android:fontFamily="sans-serif"
            android:maxLines="1"
            android:textColor="#CBD5E1"
            android:textSize="10sp"
            tools:text="24 aplikasi terpasang" />
    </LinearLayout>

    <!-- Ring Fokus Putih ala Google TV -->
    <View
        android:id="@+id/viewTopPickFocusBorder"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone" />
</FrameLayout>
