<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/wolfHostRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipChildren="false"
    android:clipToPadding="false">

    <!-- KIRI ATAS: WIDGET CUACA + INFORMASI PENYIMPANAN AKTUAL DI BAWAHNYA -->
    <LinearLayout
        android:id="@+id/layoutWolfTopLeftColumn"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentStart="true"
        android:layout_alignParentTop="true"
        android:layout_marginStart="36dp"
        android:layout_marginTop="24dp"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:orientation="vertical">

        <!-- 1. Widget Cuaca Wolf (Sumber Data & Animasi Asli WeatherHelper Aero TV) -->
        <LinearLayout
            android:id="@+id/cardWolfWeather"
            android:layout_width="268dp"
            android:layout_height="wrap_content"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="16dp"
            android:paddingTop="13dp"
            android:paddingEnd="14dp"
            android:paddingBottom="13dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        android:layout_width="13dp"
                        android:layout_height="13dp"
                        android:contentDescription="Lokasi"
                        android:src="@drawable/ic_wolf_pin" />

                    <TextView
                        android:id="@+id/tvWolfWeatherLocation"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="5dp"
                        android:ellipsize="end"
                        android:fontFamily="sans-serif-bold"
                        android:maxLines="1"
                        android:shadowColor="#AA000000"
                        android:shadowDx="1"
                        android:shadowDy="1"
                        android:shadowRadius="3"
                        android:text="MENDETEKSI LOKASI"
                        android:textColor="#E0F2FE"
                        android:textSize="10sp" />
                </LinearLayout>

                <TextView
                    android:id="@+id/tvWolfWeatherTemp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:fontFamily="sans-serif-medium"
                    android:shadowColor="#B0000000"
                    android:shadowDx="1"
                    android:shadowDy="2"
                    android:shadowRadius="4"
                    android:text="--°"
                    android:textColor="#FFFFFF"
                    android:textSize="27sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvWolfWeatherCondition"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:fontFamily="sans-serif-medium"
                    android:maxLines="1"
                    android:shadowColor="#AA000000"
                    android:shadowDx="1"
                    android:shadowDy="1"
                    android:shadowRadius="3"
                    android:text="Memuat cuaca..."
                    android:textColor="#F1F5F9"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/tvWolfWeatherSubtitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:text="Ketuk OK untuk segarkan cuaca"
                    android:textColor="#CBE6FD"
                    android:textSize="10sp" />
            </LinearLayout>

            <com.example.WeatherAnimationView
                android:id="@+id/wolfWeatherAnimView"
                android:layout_width="54dp"
                android:layout_height="54dp"
                android:layout_marginStart="10dp" />
        </LinearLayout>

        <!-- 2. Informasi Penyimpanan Perangkat Aktual (Di Bawah Widget Cuaca) -->
        <LinearLayout
            android:id="@+id/cardWolfStorage"
            android:layout_width="268dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:clickable="true"
            android:focusable="true"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingTop="12dp"
            android:paddingEnd="14dp"
            android:paddingBottom="12dp">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="13dp"
                    android:layout_height="13dp"
                    android:contentDescription="Penyimpanan Perangkat"
                    android:src="@drawable/ic_wolf_storage" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:fontFamily="sans-serif-bold"
                    android:letterSpacing="0.04"
                    android:text="PENYIMPANAN &amp; MEMORI"
                    android:textColor="#BAE6FD"
                    android:textSize="10sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/tvWolfStorageAvailable"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:ellipsize="end"
                android:fontFamily="sans-serif-bold"
                android:maxLines="1"
                android:shadowColor="#AA000000"
                android:shadowDx="1"
                android:shadowDy="1"
                android:shadowRadius="4"
                android:text="-- GB tersedia"
                android:textColor="#FFFFFF"
                android:textSize="18sp" />

            <TextView
                android:id="@+id/tvWolfStorageInternal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:ellipsize="end"
                android:fontFamily="sans-serif"
                android:maxLines="1"
                android:text="Terpakai: -- / --"
                android:textColor="#E2E8F0"
                android:textSize="11sp" />

            <TextView
                android:id="@+id/tvWolfRamAvailable"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="1dp"
                android:ellipsize="end"
                android:fontFamily="sans-serif"
                android:maxLines="1"
                android:text="Memori RAM tersedia: --"
                android:textColor="#BAE6FD"
                android:textSize="10.5sp" />
        </LinearLayout>
    </LinearLayout>

    <!-- KANAN ATAS: STATUS SISTEM AKTUAL + JAM DIGITAL BESAR + HARI & TANGGAL -->
    <LinearLayout
        android:id="@+id/layoutWolfTopRight"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentTop="true"
        android:layout_alignParentEnd="true"
        android:layout_marginTop="24dp"
        android:layout_marginEnd="36dp"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:gravity="end"
        android:orientation="vertical">

        <LinearLayout
            android:id="@+id/layoutWolfSystemStatusRow"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvWolfNetSpeed"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="10dp"
                android:background="@drawable/bg_pill_focus_title"
                android:fontFamily="sans-serif-bold"
                android:paddingStart="10dp"
                android:paddingTop="5dp"
                android:paddingEnd="10dp"
                android:paddingBottom="5dp"
                android:text="↓ 0.0 KB/s"
                android:textColor="#E2E8F0"
                android:textSize="10.5sp" />

            <ImageButton
                android:id="@+id/btnWolfWifi"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:layout_marginEnd="8dp"
                android:contentDescription="Status Wi-Fi"
                android:focusable="true"
                android:padding="8dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_wifi" />

            <ImageButton
                android:id="@+id/btnWolfBluetooth"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:layout_marginEnd="8dp"
                android:contentDescription="Status Bluetooth"
                android:focusable="true"
                android:padding="8dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_bluetooth" />

            <ImageButton
                android:id="@+id/btnWolfDisplaySettings"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:layout_marginEnd="8dp"
                android:contentDescription="Pengaturan Tampilan Wolf"
                android:focusable="true"
                android:padding="8dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_atv_tune" />

            <ImageButton
                android:id="@+id/btnWolfSettings"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:contentDescription="Pengaturan Launcher"
                android:focusable="true"
                android:padding="8dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_settings" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/layoutWolfClockGroup"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="end"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvWolfClock"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-light"
                android:includeFontPadding="false"
                android:shadowColor="#CC000000"
                android:shadowDx="2"
                android:shadowDy="2"
                android:shadowRadius="8"
                android:text="00:00"
                android:textColor="#FFFFFF"
                android:textSize="42sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvWolfDate"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:fontFamily="sans-serif-medium"
                android:shadowColor="#CC000000"
                android:shadowDx="1"
                android:shadowDy="1"
                android:shadowRadius="5"
                android:text="Hari, 1 Jan 2026"
                android:textColor="#E2E8F0"
                android:textSize="13sp" />
        </LinearLayout>
    </LinearLayout>

    <!-- BAGIAN BAWAH: DOCK TRANSPARAN HORIZONTAL MEMBULAT + TOMBOL ALL APPS DI KANAN -->
    <LinearLayout
        android:id="@+id/layoutWolfDockOuter"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:layout_centerHorizontal="true"
        android:layout_marginStart="28dp"
        android:layout_marginEnd="28dp"
        android:layout_marginBottom="18dp"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:gravity="end"
        android:orientation="vertical">

        <LinearLayout
            android:id="@+id/layoutWolfDockBox"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="14dp"
            android:paddingTop="10dp"
            android:paddingEnd="14dp"
            android:paddingBottom="8dp">

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvWolfDockApps"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:clipChildren="false"
                android:clipToPadding="false"
                android:overScrollMode="never" />

            <View
                android:id="@+id/viewWolfDockDivider"
                android:layout_width="1dp"
                android:layout_height="44dp"
                android:layout_marginStart="10dp"
                android:layout_marginEnd="10dp"
                android:background="#44FFFFFF" />

            <!-- Tombol All Apps di sisi kanan dock -> membuka App Drawer asli Aero TV -->
            <LinearLayout
                android:id="@+id/btnWolfAllApps"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:clickable="true"
                android:clipChildren="false"
                android:clipToPadding="false"
                android:focusable="true"
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:padding="4dp">

                <FrameLayout
                    android:id="@+id/wolfAllAppsIconBox"
                    android:layout_width="58dp"
                    android:layout_height="58dp">

                    <ImageView
                        android:id="@+id/ivWolfAllAppsIcon"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:contentDescription="Semua Aplikasi"
                        android:padding="13dp"
                        android:scaleType="fitCenter"
                        android:src="@drawable/ic_wolf_all_apps" />
                </FrameLayout>

                <TextView
                    android:id="@+id/tvWolfAllAppsDockLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:fontFamily="sans-serif-bold"
                    android:gravity="center"
                    android:shadowColor="#E6000000"
                    android:shadowDx="1"
                    android:shadowDy="1"
                    android:shadowRadius="4"
                    android:text="Semua"
                    android:textColor="#FFFFFF"
                    android:textSize="11sp"
                    android:visibility="invisible" />
            </LinearLayout>
        </LinearLayout>

        <TextView
            android:id="@+id/tvWolfAllAppsCaption"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:layout_marginEnd="14dp"
            android:fontFamily="sans-serif-bold"
            android:shadowColor="#DD000000"
            android:shadowDx="1"
            android:shadowDy="1"
            android:shadowRadius="4"
            android:text="Semua Aplikasi"
            android:textColor="#F1F5F9"
            android:textSize="11.5sp" />
    </LinearLayout>

</RelativeLayout>
