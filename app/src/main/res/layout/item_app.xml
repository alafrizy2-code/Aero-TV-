<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/itemAppContainer"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:layout_gravity="center_horizontal"
    android:layout_marginStart="0px"
    android:layout_marginEnd="0px"
    android:layout_marginTop="0px"
    android:layout_marginBottom="0px"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:clickable="true"
    android:focusable="true"
    android:gravity="center_horizontal"
    android:orientation="vertical">

    <!-- Kartu Horizontal Rounded Rectangular App Tile (216 x 120 px, Rasio 16:9, Corner Radius 22 px) -->
    <FrameLayout
        android:id="@+id/cardApp"
        android:layout_width="@dimen/tv_card_width"
        android:layout_height="@dimen/tv_card_height"
        android:duplicateParentState="true"
        android:background="@drawable/bg_app_card"
        android:outlineProvider="background"
        android:clipToOutline="true"
        android:padding="8px">

        <ImageView
            android:id="@+id/ivAppIcon"
            android:layout_width="@dimen/tv_app_icon_size"
            android:layout_height="@dimen/tv_app_icon_size"
            android:layout_gravity="center"
            android:adjustViewBounds="true"
            android:contentDescription="Ikon Aplikasi"
            android:scaleType="fitCenter"
            tools:src="@drawable/ic_launcher_foreground" />

        <TextView
            android:id="@+id/tvSlotBadge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="top|end"
            android:background="#55000000"
            android:fontFamily="sans-serif-bold"
            android:paddingStart="4dp"
            android:paddingTop="1dp"
            android:paddingEnd="4dp"
            android:paddingBottom="1dp"
            android:textColor="#E2E8F0"
            android:textSize="8sp"
            android:visibility="gone"
            tools:text="#1"
            tools:visibility="visible" />
    </FrameLayout>

    <!-- Nama Aplikasi di Bawah Ikon dengan Ukuran Pas Sesuai Lebar Kartu -->
    <TextView
        android:id="@+id/tvAppName"
        android:layout_width="@dimen/tv_card_width"
        android:layout_height="wrap_content"
        android:layout_marginTop="5px"
        android:ellipsize="marquee"
        android:fontFamily="sans-serif-medium"
        android:gravity="center"
        android:marqueeRepeatLimit="marquee_forever"
        android:maxLines="1"
        android:singleLine="true"
        android:shadowColor="#CC000000"
        android:shadowDx="1"
        android:shadowDy="1"
        android:shadowRadius="4"
        android:text="Nama Aplikasi"
        android:textColor="#FFFFFF"
        android:textSize="11sp" />

</LinearLayout>
