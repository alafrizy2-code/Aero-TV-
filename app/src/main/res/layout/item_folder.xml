<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/itemFolderContainer"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:layout_marginStart="8dp"
    android:layout_marginEnd="8dp"
    android:clickable="true"
    android:focusable="true"
    android:gravity="center_horizontal"
    android:orientation="vertical">

    <!-- Medium Rounded Card Box containing Folder Icon & Count Badge -->
    <FrameLayout
        android:id="@+id/cardFolder"
        android:layout_width="116dp"
        android:layout_height="78dp"
        android:duplicateParentState="true"
        android:background="@drawable/bg_app_card"
        android:padding="6dp">

        <!-- Medium-sized Folder Icon (not too small) -->
        <ImageView
            android:id="@+id/ivFolderIcon"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_gravity="center"
            android:adjustViewBounds="true"
            android:contentDescription="Folder Icon"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_folder" />

        <!-- App count pill badge in top right -->
        <TextView
            android:id="@+id/tvFolderBadge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="top|end"
            android:layout_marginTop="2dp"
            android:layout_marginEnd="2dp"
            android:background="#804B5563"
            android:paddingStart="6dp"
            android:paddingTop="1dp"
            android:paddingEnd="6dp"
            android:paddingBottom="1dp"
            android:textColor="#E9D5FF"
            android:textSize="9sp"
            android:fontFamily="sans-serif-bold"
            tools:text="4" />
    </FrameLayout>

    <!-- Folder Title below card -->
    <TextView
        android:id="@+id/tvFolderName"
        android:layout_width="116dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="5dp"
        android:ellipsize="marquee"
        android:fontFamily="sans-serif-bold"
        android:gravity="center"
        android:marqueeRepeatLimit="marquee_forever"
        android:maxLines="1"
        android:singleLine="true"
        android:shadowColor="#CC000000"
        android:shadowDx="1"
        android:shadowDy="1"
        android:shadowRadius="4"
        android:textColor="#FFFFFF"
        android:textSize="12sp"
        tools:text="Streaming &amp; TV" />

</LinearLayout>
