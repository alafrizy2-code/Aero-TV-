<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <corners android:radius="14dp" />
            <solid android:color="#599333EA" />
            <stroke android:width="3.5dp" android:color="#C084FC" />
        </shape>
    </item>
    <item android:state_selected="true">
        <shape android:shape="rectangle">
            <corners android:radius="14dp" />
            <solid android:color="#409333EA" />
            <stroke android:width="2.5dp" android:color="#A855F7" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="14dp" />
            <solid android:color="#301E293B" />
            <stroke android:width="1dp" android:color="#22FFFFFF" />
        </shape>
    </item>
</selector>
