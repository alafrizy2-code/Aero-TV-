<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Google TV Focus Highlight: Outline Putih Tebal 4px + Glow Elegan -->
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <corners android:radius="22px" />
            <solid android:color="#33FFFFFF" />
            <stroke android:width="4px" android:color="#FFFFFF" />
        </shape>
    </item>
    <item android:state_selected="true">
        <shape android:shape="rectangle">
            <corners android:radius="22px" />
            <solid android:color="#33FFFFFF" />
            <stroke android:width="4px" android:color="#FFFFFF" />
        </shape>
    </item>
    <!-- Normal: Kartu Horizontal 15px Rounded -->
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="15px" />
            <solid android:color="#26101726" />
            <stroke android:width="1px" android:color="#26FFFFFF" />
        </shape>
    </item>
</selector>
